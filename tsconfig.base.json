{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@codesoul-co/core": ["packages/core/src"],
      "@codesoul-co/core/*": ["packages/core/src/*"],
      "@codesoul-co/storage": ["packages/storage/src"],
      "@codesoul-co/storage/*": ["packages/storage/src/*"],
      "@codesoul-co/fsm": ["packages/fsm/src"],
      "@codesoul-co/fsm/*": ["packages/fsm/src/*"],
      "@codesoul-co/kernel": ["packages/kernel/src"],
      "@codesoul-co/kernel/*": ["packages/kernel/src/*"],
      "@codesoul-co/harness": ["packages/harness/src"],
      "@codesoul-co/harness/*": ["packages/harness/src/*"],
      "@codesoul-co/models": ["packages/models/src"],
      "@codesoul-co/models/*": ["packages/models/src/*"],
      "@codesoul-co/serving-cache": ["packages/serving-cache/src"],
      "@codesoul-co/serving-cache/*": ["packages/serving-cache/src/*"],
      "@codesoul-co/workcache": ["packages/workcache/src"],
      "@codesoul-co/workcache/*": ["packages/workcache/src/*"],
      "@codesoul-co/memory": ["packages/memory/src"],
      "@codesoul-co/memory/*": ["packages/memory/src/*"],
      "@codesoul-co/tools": ["packages/tools/src"],
      "@codesoul-co/tools/*": ["packages/tools/src/*"],
      "@codesoul-co/mcp": ["packages/mcp/src"],
      "@codesoul-co/mcp/*": ["packages/mcp/src/*"],
      "@codesoul-co/skills": ["packages/skills/src"],
      "@codesoul-co/skills/*": ["packages/skills/src/*"],
      "@codesoul-co/domain": ["packages/domain/src"],
      "@codesoul-co/domain/*": ["packages/domain/src/*"],
      "@codesoul-co/inference": ["packages/inference/src"],
      "@codesoul-co/inference/*": ["packages/inference/src/*"],
      "@codesoul-co/adapters-local": ["packages/adapters-local/src"],
      "@codesoul-co/adapters-local/*": ["packages/adapters-local/src/*"],
      "@codesoul-co/testing": ["packages/testing/src"],
      "@codesoul-co/testing/*": ["packages/testing/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true
  }
}
