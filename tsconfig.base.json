{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@codesoul-co/hypha-core": ["packages/core/src"],
      "@codesoul-co/hypha-core/*": ["packages/core/src/*"],
      "@codesoul-co/hypha-storage": ["packages/storage/src"],
      "@codesoul-co/hypha-storage/*": ["packages/storage/src/*"],
      "@codesoul-co/hypha-fsm": ["packages/fsm/src"],
      "@codesoul-co/hypha-fsm/*": ["packages/fsm/src/*"],
      "@codesoul-co/hypha-kernel": ["packages/kernel/src"],
      "@codesoul-co/hypha-kernel/*": ["packages/kernel/src/*"],
      "@codesoul-co/hypha-harness": ["packages/harness/src"],
      "@codesoul-co/hypha-harness/*": ["packages/harness/src/*"],
      "@codesoul-co/hypha-models": ["packages/models/src"],
      "@codesoul-co/hypha-models/*": ["packages/models/src/*"],
      "@codesoul-co/hypha-serving-cache": ["packages/serving-cache/src"],
      "@codesoul-co/hypha-serving-cache/*": ["packages/serving-cache/src/*"],
      "@codesoul-co/hypha-workcache": ["packages/workcache/src"],
      "@codesoul-co/hypha-workcache/*": ["packages/workcache/src/*"],
      "@codesoul-co/hypha-memory": ["packages/memory/src"],
      "@codesoul-co/hypha-memory/*": ["packages/memory/src/*"],
      "@codesoul-co/hypha-tools": ["packages/tools/src"],
      "@codesoul-co/hypha-tools/*": ["packages/tools/src/*"],
      "@codesoul-co/hypha-mcp": ["packages/mcp/src"],
      "@codesoul-co/hypha-mcp/*": ["packages/mcp/src/*"],
      "@codesoul-co/hypha-skills": ["packages/skills/src"],
      "@codesoul-co/hypha-skills/*": ["packages/skills/src/*"],
      "@codesoul-co/hypha-domain": ["packages/domain/src"],
      "@codesoul-co/hypha-domain/*": ["packages/domain/src/*"],
      "@codesoul-co/hypha-inference": ["packages/inference/src"],
      "@codesoul-co/hypha-inference/*": ["packages/inference/src/*"],
      "@codesoul-co/hypha-adapters-local": ["packages/adapters-local/src"],
      "@codesoul-co/hypha-adapters-local/*": ["packages/adapters-local/src/*"],
      "@codesoul-co/hypha-testing": ["packages/testing/src"],
      "@codesoul-co/hypha-testing/*": ["packages/testing/src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true
  }
}
